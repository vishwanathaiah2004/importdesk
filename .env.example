# Copy this file to .env and fill in the values.
# Never commit .env — it is ignored by .gitignore.

# Supabase → Connect → ORMs → Prisma (Mumbai region project)
DATABASE_URL=
DIRECT_URL=

# Signs the login cookie. At least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Google AI Studio API key (server-side only)
GEMINI_API_KEY=

# Optional: override the Gemini model (see src/lib/extraction/gemini.ts for the default)
GEMINI_MODEL=





